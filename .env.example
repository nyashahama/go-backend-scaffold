PORT=8080
ENV=development

DATABASE_URL=postgres://user:change-me-local-dev@localhost:5432/scaffold?sslmode=disable
REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme-use-openssl-rand-base64-32
JWT_ACCESS_TOKEN_ISSUER=__scaffold_issuer__
JWT_ACCESS_TOKEN_AUDIENCE=__scaffold_audience__
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h

# Runtime proxy trust settings
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Example App

# Optional: protect /metrics in production when enabled.
METRICS_BEARER_TOKEN=

# App
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Reverse proxy / ingress trust. Leave disabled unless you have a trusted proxy in front of the app.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
